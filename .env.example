# =============================================
# Health Video Bot — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================

# LLM Provider (choose one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=           # free tier at console.groq.com — recommended for dev/testing
NVIDIA_API_KEY=         # build.nvidia.com — free credits, OpenAI-compatible
OPENROUTER_API_KEY=     # openrouter.ai — unified access to many models

# LLM model to use for claim extraction + content generation
# Anthropic:   claude-sonnet-4-6, claude-haiku-4-5-20251001
# OpenAI:      gpt-4o, gpt-4o-mini
# Groq (free): llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# NVIDIA:      meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct
# OpenRouter:  meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-sonnet
LLM_MODEL=llama-3.3-70b-versatile

# Which provider to use: auto | anthropic | openai | groq | nvidia | openrouter
# "auto" resolves as: claude* → anthropic, everything else → openai
# Set explicitly for groq/nvidia/openrouter (their model names need an explicit provider)
LLM_PROVIDER=groq

# Sarvam AI — Hindi TTS
SARVAM_API_KEY=

# B-roll Sources
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Image Generation (choose one)
# Option A: OpenAI DALL-E 3
# OPENAI_API_KEY already covers this

# Option B: Google Vertex AI (Imagen)
GOOGLE_APPLICATION_CREDENTIALS=path/to/vertex_credentials.json
GOOGLE_CLOUD_PROJECT=your_project_id

# YouTube Data API v3
# Path to your OAuth 2.0 client secrets file downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_PATH=credentials.json
# Path where the OAuth token will be saved after first auth
YOUTUBE_TOKEN_PATH=token.json

# Pipeline settings
JOBS_DIR=jobs
ASSETS_DIR=assets
LOGS_DIR=logs
CACHE_DIR=cache
NICHE_PROFILE_PATH=niche_profile.json

# Whisper settings
# Options: tiny, base, small, medium, large-v3
# large-v3 is most accurate for Hindi but slowest
WHISPER_MODEL=large-v3
# Set to "cuda" if you have a GPU, "cpu" otherwise
WHISPER_DEVICE=cpu

# Notifications (optional — get a message when a job fails)
# Leave blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
